# Stage 1: Build
FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /app

# Copy solution and project files
COPY LibraryManagement.slnx ./
COPY src/LibraryManagement.Shared/LibraryManagement.Shared.csproj src/LibraryManagement.Shared/
COPY src/LibraryManagement.Infrastructure/LibraryManagement.Infrastructure.csproj src/LibraryManagement.Infrastructure/
COPY src/LibraryManagement.API/LibraryManagement.API.csproj src/LibraryManagement.API/
COPY src/LibraryManagement.Worker/LibraryManagement.Worker.csproj src/LibraryManagement.Worker/

# Restore dependencies
RUN dotnet restore src/LibraryManagement.Worker/LibraryManagement.Worker.csproj

# Copy all sources and build
COPY src/ src/
WORKDIR /app/src/LibraryManagement.Worker
RUN dotnet publish -c Release -o /app/publish --no-restore

# Stage 2: Runtime
FROM mcr.microsoft.com/dotnet/runtime:10.0 AS runtime
WORKDIR /app
COPY --from=build /app/publish .

ENTRYPOINT ["dotnet", "LibraryManagement.Worker.dll"]
